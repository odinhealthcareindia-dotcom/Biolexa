# Sanity.io Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-01"

# Sanity API Tokens (Keep secure on Server only)
# Read token with preview permissions (Viewer role or custom)
SANITY_API_READ_TOKEN="your_read_token_here"
# Write token for product migrations (Editor role or custom)
SANITY_API_WRITE_TOKEN="your_write_token_here"

# Webhook & Preview Protection Secrets
SANITY_REVALIDATE_SECRET="your_revalidate_secret_here"
SANITY_PREVIEW_SECRET="your_preview_secret_here"

# SMTP Configuration (Nodemailer)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password_here"
CONTACT_EMAIL="biolexaindia@gmail.com"

# Chatbot Api key
OPENROUTER_API_KEY="your_openrouter_api_key_here"